# syntax=docker/dockerfile:1.7-labs
FROM python:3.14.1-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV APP_MODULE=app:server \
       UVICORN_WORKERS=1 \
       TZ=Europe/Budapest \
       DB_HOST=postgresql \
       DB_PORT=5432 \
       DB_NAME=n8n \
       CRUCIX_API_URL=http://crucix:3117/api/data

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY requirements-dash.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements-dash.txt

COPY apis/ apis/
COPY app_assets/ app_assets/
COPY app_pages/ app_pages/
COPY model_pages/ model_pages/
COPY model_assets/ model_assets/
COPY app.py .
COPY home.py .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 CMD curl -fsS http://localhost:8000/health || exit 1

CMD gunicorn ${APP_MODULE:-app:server} -k uvicorn.workers.UvicornWorker \
    --workers=${UVICORN_WORKERS:-1} \
    --threads=${GUNICORN_THREADS:-4} \
    --timeout=${GUNICORN_TIMEOUT:-120} \
    --bind 0.0.0.0:8000
